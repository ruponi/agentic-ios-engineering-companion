#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SCRATCH=${TMPDIR:-/tmp}/fieldnotes-chapter20-build
TRACE=${TMPDIR:-/tmp}/fieldnotes-chapter20-trace.txt
PLACEMENT_TRACE=${TMPDIR:-/tmp}/fieldnotes-chapter21-placement-trace.txt
IOS_MODULE_CACHE=${TMPDIR:-/tmp}/fieldnotes-chapter22-ios-module-cache
IOS_SDK=$(xcrun --sdk iphoneos --show-sdk-path)

cd "$ROOT"
env CLANG_MODULE_CACHE_PATH=/tmp/chapter20-clang-cache SWIFT_MODULE_CACHE_PATH=/tmp/chapter20-swift-cache \
    swift build --scratch-path "$SCRATCH"
env CLANG_MODULE_CACHE_PATH=/tmp/chapter20-clang-cache SWIFT_MODULE_CACHE_PATH=/tmp/chapter20-swift-cache \
    swift test --scratch-path "$SCRATCH"
env CLANG_MODULE_CACHE_PATH=/tmp/chapter20-clang-cache SWIFT_MODULE_CACHE_PATH=/tmp/chapter20-swift-cache \
    swift run --scratch-path "$SCRATCH" AgentLoopTrace > "$TRACE"
diff -u Artifacts/chapter20-run/expected-trace.txt "$TRACE"
env CLANG_MODULE_CACHE_PATH=/tmp/chapter20-clang-cache SWIFT_MODULE_CACHE_PATH=/tmp/chapter20-swift-cache \
    swift run --scratch-path "$SCRATCH" PlacementTrace > "$PLACEMENT_TRACE"
diff -u Artifacts/chapter21-run/expected-placement-trace.txt "$PLACEMENT_TRACE"
xcrun swiftc \
    -typecheck \
    -swift-version 6 \
    -strict-concurrency=complete \
    -module-cache-path "$IOS_MODULE_CACHE" \
    -target arm64-apple-ios17.0 \
    -sdk "$IOS_SDK" \
    Sources/FieldNotesAgentLoop/*.swift
printf 'chapter20 verify: PASS\n'
